COMPOSE_PROJECT_NAME=orders-pilot

# MySQL
MYSQL_ROOT_PASSWORD=mysql_root_pwd
MYSQL_DATABASE=sales_mysql
MYSQL_DEBEZIUM_USER=debezium
MYSQL_DEBEZIUM_PASSWORD=dbz_pwd

# PostgreSQL
POSTGRES_USER=pilot
POSTGRES_PASSWORD=pilot_pwd
POSTGRES_DB=sales_postgres

# MongoDB
MONGO_USER=root
MONGO_PASSWORD=mongo_pwd
MONGO_DATABASE=Ordini

# Metabase
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=Pilot-Admin#2024

# Generators (seconds)
MYSQL_GENERATOR_INTERVAL=5
POSTGRES_GENERATOR_INTERVAL=6

# Host ports
PORT_MYSQL=3306
PORT_POSTGRES=5432
PORT_KAFKA=29092
PORT_CONNECT=8083
PORT_MONGO=27017
PORT_NIFI=8081
PORT_METABASE=3000
